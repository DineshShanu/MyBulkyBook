@{
    string? message = null;
    string alertClass = "";

    if (TempData["Success"] != null)
    {
        message = TempData["Success"]?.ToString();
        //alertClass = "alert-success";  -- Option - 1
        alertClass = "success";
    }
    else if (TempData["Update"] != null)
    {
        message = TempData["Update"]?.ToString();
        //alertClass = "alert-warning";  -- Option - 1
        alertClass = "warning";
    }
    else if (TempData["Delete"] != null)
    {
        message = TempData["Delete"]?.ToString();
        //alertClass = "alert-danger";  -- Option - 1
        alertClass = "error";
    }
}

@if (message != null)
{
   @*  Option - 1
       <div id="successAlert" class="alert @alertClass alert-dismissible fade show" role="alert">
        @message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div> *@

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>
    <script>
        toastr.@alertClass ('@message');
    </script>
}